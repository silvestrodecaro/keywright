{
  "name": "keywright",
  "version": "0.4.1",
  "private": true,
  "description": "IDE for Robot Framework (Browser library) with a Playwright-style test generator",
  "author": "Silvestro De Caro",
  "repository": {
    "type": "git",
    "url": "https://github.com/silvestrodecaro/keywright.git"
  },
  "homepage": "https://github.com/silvestrodecaro/keywright",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "start": "node scripts/start.js",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "npm run build && playwright test",
    "lint": "biome lint .",
    "install-browsers": "playwright-core install chromium"
  },
  "license": "MIT",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "1.65.0",
    "dompurify": "3.4.17",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
